# Copie para .env (o .env está no .gitignore)
POSTGRES_USER=creche
POSTGRES_PASSWORD=creche
POSTGRES_DB=creche

# Backend local (fora do Docker). Dentro do compose o host vira `db`.
DATABASE_URL=postgresql+psycopg://creche:creche@localhost:5432/creche
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Comprovação de critérios: mock (padrão) | conecta | rmi | todos
COMPROVACAO_PROVIDER=mock
# Rotina que expira convocações com prazo vencido (minutos; 0 = desligada — o polo expira em lote pelo painel)
EXPIRACAO_AUTOMATICA_MINUTOS=0

# Assistente (chat com tools nas áreas CRE e Nível Central). Sem a chave, o botão "Perguntar ao painel"
# avisa que o assistente não está configurado e o painel segue funcionando.
# ANTHROPIC_API_KEY=sk-ant-...
CHAT_MODEL=claude-opus-5
CHAT_MAX_TOOLS=8

# Mapa do pré-cadastro (Leaflet). Padrão: Esri Light Gray Canvas, sem chave e sem marca d'água
# (o CARTO Positron carimba "API KEY REQUIRED" sem chave). Para outro provedor, ex.:
# VITE_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE
# VITE_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# VITE_MAP_SUBDOMAINS=abcd   (só se a URL tiver {s})
