# Copie para .env (o .env está no .gitignore)
POSTGRES_USER=creche
POSTGRES_PASSWORD=creche
POSTGRES_DB=creche

# Backend local (fora do Docker). Dentro do compose o host vira `db`.
DATABASE_URL=postgresql+psycopg://creche:creche@localhost:5432/creche
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Comprovação de critérios: mock (padrão) | conecta | rmi | todos
COMPROVACAO_PROVIDER=mock
# Motor contínuo (classifica, convoca e repassa vaga liberada sozinho). 0 desliga a rotina de fundo.
MOTOR_INTERVALO_SEGUNDOS=60
MOTOR_MAX_REPASSES_POR_CICLO=200
# Deixe 1 para o motor também registrar as convocações com prazo vencido (na demonstração fica 0, para as
# vencidas aparecerem no painel e o polo registrar em lote)
MOTOR_EXPIRAR_VENCIDAS=0

# Assistente (chat com tools nas áreas CRE e Nível Central). Sem a chave, o botão "Perguntar ao painel"
# avisa que o assistente não está configurado e o painel segue funcionando.
# ANTHROPIC_API_KEY=sk-ant-...
CHAT_MODEL=claude-opus-5
CHAT_MAX_TOOLS=8

# ─── Mensageria (container `mensageria/`, porta 8100) ────────────────────────────────────────────
# Provedor por canal. `mock` (padrão) não envia nada: registra e devolve `simulado`.
MENSAGERIA_WHATSAPP=mock        # mock | twilio
MENSAGERIA_EMAIL=mock           # mock | resend | smtp
MENSAGERIA_SMS=mock             # mock | twilio
# Token compartilhado backend ↔ mensageria. Vazio = API aberta (só para desenvolvimento local).
# MENSAGERIA_TOKEN=
# Onde o backend encontra o serviço. No compose isso já vem definido como http://mensageria:8100/api/v1
MENSAGERIA_URL=http://localhost:8100/api/v1
# MENSAGERIA_ATIVO=0 faz o backend nem chamar o serviço (envios viram `pendente`) — use na carga e no seed.
MENSAGERIA_ATIVO=1

# WhatsApp via Twilio. Cada celular que vai RECEBER precisa mandar uma vez "join <código>" por WhatsApp
# para o número do sandbox (opt-in exigido pelo WhatsApp). O número e o código saem no console, em
# Messaging → Try it out → Send a WhatsApp message. Atenção: o número do sandbox VARIA POR CONTA.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# SMS exige número comprado — o sandbox é só WhatsApp. Sem isto, o canal SMS fica `pendente`.
# TWILIO_SMS_FROM=+1...
#
# Content Templates. O WhatsApp só aceita texto livre dentro da janela de 24 h; fora dela exige template
# aprovado. Em conta TRIAL, texto livre nunca passa (`21654 ContentSid Required`) — só dá para enviar por
# um dos templates que a Twilio provisiona, e os `HX...` deles saem do console (Messaging → Try it out),
# porque a Content API que os listaria responde 401 em trial. Mapa `template do catálogo → HX...`:
#   cada item de "variaveis" é um molde preenchido com os `dados` do pedido, na ordem dos {{1}}, {{2}}…
#   Sem entrada para um template, o envio usa texto livre.
# TWILIO_CONTENT_SIDS={"convocacao_vaga":{"sid":"HX...","variaveis":["{crianca}","{unidade}","{prazo}"]}}

# E-mail via Resend. Sem domínio verificado, o remetente de teste onboarding@resend.dev só entrega
# no e-mail dono da conta Resend.
# RESEND_API_KEY=re_...
RESEND_FROM=Inscricao Creche <onboarding@resend.dev>

# E-mail via SMTP (alternativa ao Resend; no Gmail exige senha de app, não a senha da conta).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=voce@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=Inscricao Creche <voce@gmail.com>

# Mapa do pré-cadastro (Leaflet). Padrão: Esri Light Gray Canvas, sem chave e sem marca d'água
# (o CARTO Positron carimba "API KEY REQUIRED" sem chave). Para outro provedor, ex.:
# VITE_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE
# VITE_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# VITE_MAP_SUBDOMAINS=abcd   (só se a URL tiver {s})
